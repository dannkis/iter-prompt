{
  "name": "iter-prompt",
  "version": "0.1.0",
  "private": true,
  "description": "A local visual prompt iteration and evaluation workspace",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "dev": "node --env-file-if-exists=.env --watch src/server.mjs",
    "test": "node --test",
    "check": "node scripts/check.mjs"
  }
}
